{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/zsh",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "allow",
    "external_directory": {
      "*": "allow"
    },
    "bash": {
      "*": "allow",
      "*rm -rf*": "ask",
      "*mkfs*": "ask",
      "*wipefs*": "ask",
      "*dd if=*": "ask",
      "*pacman -Rdd*": "ask",
      "*pacman -Syu*": "ask",
      "*shutdown*": "ask",
      "*reboot*": "ask",
      "*visudo*": "ask"
    }
  }
}
